{
  "name": "@omp-desktop/plugin-desktop-pet",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "main": "dist/cjs/client.js",
  "files": ["dist", "src", "assets", "!src/**/*.test.*"],
  "scripts": { "build": "npm run build --workspace=@omp-desktop/plugin && node ../../../scripts/build-desktop-plugins.mjs plugins/desktop-pet", "prepack": "npm run build" },
  "exports": {
    ".": { "types": "./dist/types/client.d.ts", "source": "./src/client.tsx", "import": "./dist/esm/client.js", "require": "./dist/cjs/client.js", "default": "./dist/esm/client.js" },
    "./client": { "types": "./dist/types/client.d.ts", "source": "./src/client.tsx", "import": "./dist/esm/client.js", "require": "./dist/cjs/client.js", "default": "./dist/esm/client.js" },
    "./service": { "types": "./dist/types/service.d.ts", "source": "./src/service.ts", "import": "./dist/esm/service.js", "require": "./dist/cjs/service.js", "default": "./dist/esm/service.js" },
    "./builtin": { "types": "./dist/types/builtin.d.ts", "source": "./src/builtin.ts", "import": "./dist/esm/builtin.js", "require": "./dist/cjs/builtin.js", "default": "./dist/esm/builtin.js" },
    "./config": { "types": "./dist/types/config.d.ts", "source": "./src/config.ts", "import": "./dist/esm/config.js", "require": "./dist/cjs/config.js", "default": "./dist/esm/config.js" },
    "./types": { "types": "./dist/types/types.d.ts", "source": "./src/types.ts", "import": "./dist/esm/types.js", "require": "./dist/cjs/types.js", "default": "./dist/esm/types.js" },
    "./creation": { "types": "./dist/types/creation.d.ts", "source": "./src/creation.ts", "import": "./dist/esm/creation.js", "require": "./dist/cjs/creation.js", "default": "./dist/esm/creation.js" },
    "./model": { "types": "./dist/types/model.d.ts", "source": "./src/model.ts", "import": "./dist/esm/model.js", "require": "./dist/cjs/model.js", "default": "./dist/esm/model.js" },
    "./rendering": { "types": "./dist/types/rendering.d.ts", "source": "./src/rendering.ts", "import": "./dist/esm/rendering.js", "require": "./dist/cjs/rendering.js", "default": "./dist/esm/rendering.js" },
    "./manifest": { "types": "./dist/types/manifest.d.ts", "source": "./src/manifest.ts", "import": "./dist/esm/manifest.js", "require": "./dist/cjs/manifest.js", "default": "./dist/esm/manifest.js" },
    "./package.json": "./package.json"
  },
  "ompDesktop": {
    "apiVersion": 1,
    "id": "desktop-pet",
    "owner": "desktop",
    "entries": { "client": "./dist/esm/client.js", "service": "./dist/esm/service.js" },
    "capabilities": ["native.overlay", "files.scoped", "native.dialog", "native.navigation", "agents.events"]
  },
  "dependencies": { "@omp-desktop/plugin": "0.6.1", "@omp-desktop/client": "*", "@omp-desktop/protocol": "*", "zod": "^4.4.3" },
  "peerDependencies": { "react": "*", "react-native": "*" }
}
