{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "daemon": {
      "type": "object",
      "properties": {
        "listen": {
          "type": "string"
        },
        "hostnames": {
          "anyOf": [
            {
              "type": "boolean",
              "const": true
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "allowedHosts": {
          "anyOf": [
            {
              "type": "boolean",
              "const": true
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "trustedProxies": {
          "anyOf": [
            {
              "type": "boolean",
              "const": true
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "mcp": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "injectIntoAgents": {
              "type": "boolean"
            },
            "toolCapabilities": {
              "type": "object",
              "properties": {
                "workspace": {
                  "type": "boolean"
                },
                "agents": {
                  "type": "boolean"
                },
                "permissions": {
                  "type": "boolean"
                },
                "terminals": {
                  "type": "boolean"
                },
                "scripts": {
                  "type": "boolean"
                },
                "providers": {
                  "type": "boolean"
                },
                "optional": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": {}
        },
        "browserTools": {},
        "git": {
          "type": "object",
          "properties": {
            "maxProcessesPerSecond": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxProcessConcurrency": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "autoArchiveAfterMerge": {
          "type": "boolean"
        },
        "enableTerminalAgentHooks": {
          "type": "boolean"
        },
        "appendSystemPrompt": {
          "type": "string"
        },
        "ompProviderAccountNotes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "cors": {
          "type": "object",
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "relay": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "endpoint": {
              "type": "string"
            },
            "publicEndpoint": {
              "type": "string"
            },
            "useTls": {
              "type": "boolean"
            },
            "publicUseTls": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "serviceProxy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "listen": {
              "type": "string"
            },
            "publicBaseUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "properties": {
            "password": {
              "type": "string",
              "pattern": "^\\$2[aby]\\$\\d{2}\\$[./A-Za-z0-9]{53}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "github": {
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "clientType": {
          "type": "string",
          "enum": ["oauth-app", "github-app"]
        },
        "hosts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "clientId": {
                "type": "string",
                "minLength": 1
              },
              "clientType": {
                "type": "string",
                "enum": ["oauth-app", "github-app"]
              },
              "apiBaseUrl": {
                "type": "string",
                "format": "uri"
              },
              "webBaseUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["clientId"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "properties": {
        "openai": {
          "type": "object",
          "properties": {
            "apiKey": {
              "type": "string",
              "minLength": 1
            },
            "baseUrl": {
              "type": "string",
              "minLength": 1
            },
            "image": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "backend": {
                  "type": "string",
                  "enum": ["openai-api", "chatgpt-subscription"]
                },
                "apiKey": {
                  "type": "string",
                  "minLength": 1
                },
                "baseUrl": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "subscriptionCredentialId": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pluginsEnabled": {
      "type": "boolean"
    },
    "plugins": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "const": "directory"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": ["source", "path"],
            "additionalProperties": false
          }
        ]
      }
    },
    "worktrees": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "servicePorts": {
          "type": "object",
          "properties": {
            "range": {
              "type": "string",
              "pattern": "^(\\d{1,5})-(\\d{1,5})$"
            },
            "portScript": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "extends": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "params": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    },
                    "isDefault": {
                      "type": "boolean"
                    },
                    "thinkingOptions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "isDefault": {
                            "type": "boolean"
                          }
                        },
                        "required": ["id", "label"]
                      }
                    }
                  },
                  "required": ["id", "label"]
                }
              },
              "additionalModels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    },
                    "isDefault": {
                      "type": "boolean"
                    },
                    "thinkingOptions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "isDefault": {
                            "type": "boolean"
                          }
                        },
                        "required": ["id", "label"]
                      }
                    }
                  },
                  "required": ["id", "label"]
                }
              },
              "disallowedTools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ompBackend": {
                "type": "string",
                "enum": ["cli", "sdk"],
                "description": "OMP-only runtime backend. Desktop-managed runtimes use SDK; standalone servers default to an installed SDK, otherwise CLI."
              },
              "ompSdkPath": {
                "type": "string",
                "pattern": "^(?:\\/|[A-Za-z]:[\\\\/]|\\\\\\\\[^\\\\]+\\\\[^\\\\]+)",
                "description": "OMP-only absolute SDK package root containing package.json, dist/node/sdk.mjs, and dist/node/rpc.mjs."
              },
              "proxyPolicy": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "default": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string",
                            "const": "direct"
                          }
                        },
                        "required": ["mode"]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string",
                            "const": "proxy"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          }
                        },
                        "required": ["mode", "url"]
                      }
                    ]
                  },
                  "providers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "mode": {
                              "type": "string",
                              "const": "direct"
                            }
                          },
                          "required": ["mode"]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "mode": {
                              "type": "string",
                              "const": "proxy"
                            },
                            "url": {
                              "type": "string",
                              "format": "uri"
                            }
                          },
                          "required": ["mode", "url"]
                        }
                      ]
                    }
                  },
                  "noProxy": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": ["enabled"]
              },
              "enabled": {
                "type": "boolean"
              },
              "order": {
                "type": "number"
              }
            }
          }
        },
        "catalogRefreshTimeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 2147483647
        },
        "metadataGeneration": {
          "type": "object",
          "properties": {
            "providers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "thinkingOptionId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["provider"],
                "additionalProperties": false
              }
            },
            "commitMessageProviders": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "thinkingOptionId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["provider"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "quickAsk": {
          "type": "object",
          "properties": {
            "providers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "thinkingOptionId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["provider"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "skills": {
          "type": "object",
          "properties": {
            "selection": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "all"
                    }
                  },
                  "required": ["mode"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "custom"
                    },
                    "skills": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": ["mode", "skills"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "webUi": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "distDir": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "log": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["trace", "debug", "info", "warn", "error", "fatal"]
        },
        "format": {
          "type": "string",
          "enum": ["pretty", "json"]
        },
        "console": {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "enum": ["trace", "debug", "info", "warn", "error", "fatal"]
            },
            "format": {
              "type": "string",
              "enum": ["pretty", "json"]
            }
          },
          "additionalProperties": false
        },
        "file": {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "enum": ["trace", "debug", "info", "warn", "error", "fatal"]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "rotate": {
              "type": "object",
              "properties": {
                "maxSize": {
                  "type": "string",
                  "minLength": 1
                },
                "maxFiles": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "title": "PaseoConfigV1"
}
