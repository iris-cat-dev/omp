# OpenAI API key used by configured AI providers.
OPENAI_API_KEY=

# Server Configuration
# Location for runtime state (agents.json, etc.). Defaults to ~/.paseo
PASEO_HOME=~/.paseo

# Listen address. Defaults to 127.0.0.1:6767
# Can be host:port, /path/to/socket, or unix:///path/to/socket
PASEO_LISTEN=127.0.0.1:6767

# GitHub Device Flow. The public project Client ID below is also compiled into
# production builds; set these only to override it. "Iv..." IDs are GitHub Apps,
# while "Ov..." IDs are OAuth Apps. Alternatively, use GH_TOKEN for API access.
PASEO_GITHUB_OAUTH_CLIENT_ID=
# PASEO_GITHUB_OAUTH_CLIENT_TYPE=github-app
# GH_TOKEN=


# Enable verbose Claude SDK stream logging (trace-level per-token logs)
PASEO_CLAUDE_DEBUG=1
