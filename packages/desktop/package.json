{
  "name": "@omp-desktop/desktop",
  "version": "0.5.2",
  "private": true,
  "description": "OMP Desktop mini-electron application",
  "license": "AGPL-3.0-or-later",
  "author": "OMP Desktop contributors",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm --prefix ../.. run build:remote-backend && npm run build:main && node scripts/stage-windows-keyrings.js && node scripts/run-electron-builder.mjs",
    "build:main": "tsc -p tsconfig.json --incremental false",
    "build:plugins": "npm run build -- --with-bundled-plugins",
    "stage:bundled-plugins": "node scripts/stage-bundled-plugins.mjs",
    "dev": "./scripts/dev.sh",
    "dev:win": "powershell ./scripts/dev.ps1",
    "test": "vitest run --exclude \"e2e/**\"",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@omp-desktop/cli": "*",
    "@omp-desktop/protocol": "*",
    "@omp-desktop/server": "*",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.9",
    "koffi": "3.3.4",
    "node-pty": "1.2.0-beta.15",
    "ws": "^8.14.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iriscat/mini-electron": "0.1.12",
    "@types/node": "24.6.0",
    "@types/ws": "^8.5.14",
    "@vscode/ripgrep-universal": "^1.18.0",
    "electron": "^41.2.0",
    "electron-builder": "26.8.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.6",
    "wait-on": "8.0.5"
  }
}
