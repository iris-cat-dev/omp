{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@getpaseo/plugin": ["./src/index.ts"],
      "@getpaseo/plugin/server": ["./src/server.ts"]
    },
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.d.ts", "../../plugins/examples/**/*.ts", "../../plugins/examples/**/*.tsx"]
}
