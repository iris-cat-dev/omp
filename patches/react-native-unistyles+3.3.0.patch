+{"version":3,"names":["convertUnistyles","hyphenate","isServer","convertToCSS","safeGetMap","map","key","nextLevelMap","get","newMap","Map","set","CSSState","mainMap","mqMap","styleTag","themesCSS","ruleGroups","dirtyRules","themesDirty","themeRuleCount","needsHydration","constructor","services","ssrTag","document","getElementById","createElement","id","head","appendChild","className","propertyKey","value","mediaQuery","isMq","firstLevelMap","secondLevelMap","thirdLevelMap","has","dirty","Set","add","hash","values","runtime","recreate","sheet","cssRules","length","deleteRule","css","insertRule","groupIndex","styles","group","parent","rules","rule","i","delete","declarations","undefined","style","cssText","index","size","clear","addTheme","theme","themeVars","prev","Object","entries","forEach","nestedKey","nestedValue","remove","getStyles","Array","from","reduce","acc","themeCss","generate","getState","classNames","property","mainState","mqState","config","state","getConfig","hydrate","hydrateState","reset"],"sourceRoot":"../../../../src","sources":["web/css/state.ts"],"sourcesContent":["import type { UnistylesValues } from '../../types'\nimport type { UnistylesServices } from '../types'\n\nimport { convertUnistyles } from '../convert'\nimport { hyphenate, isServer } from '../utils'\nimport { convertToCSS } from './core'\n\ntype MapType = Map<string, Map<string, Map<string, any>>>\ntype RuleGroup = {\n    sheet: CSSStyleSheet | CSSGroupingRule\n    rules: Map<string, CSSStyleRule>\n}\ntype SetProps = {\n    mediaQuery?: string\n    className: string\n    isMq?: boolean\n    propertyKey: string\n    value: any\n}\ntype HydrateState = Array<[string, Array<[string, Array<[string, any]>]>]>\n\nconst safeGetMap = (map: Map<string, Map<string, any>>, key: string) => {\n    const nextLevelMap = map.get(key)\n\n    if (!nextLevelMap) {\n        const newMap = new Map<string, any>()\n\n        map.set(key, newMap)\n\n        return newMap\n    }\n\n    return nextLevelMap\n}\n\nexport class CSSState {\n    mainMap: MapType = new Map()\n    mqMap: MapType = new Map()\n    private styleTag: HTMLStyleElement | null = null\n    private themesCSS = new Map<string, string>()\n    private ruleGroups = new Map<Map<string, Map<string, any>>, RuleGroup>()\n    private dirtyRules = new Map<Map<string, Map<string, any>>, Set<string>>()\n    private themesDirty = false\n    private themeRuleCount = 0\n    private needsHydration = false\n\n    constructor(private services: UnistylesServices) {\n        if (isServer()) {\n            return\n        }\n\n        const ssrTag = document.getElementById('unistyles-web')\n\n        if (ssrTag) {\n            this.styleTag = ssrTag as HTMLStyleElement\n            this.needsHydration = true\n\n            return\n        }\n\n        this.styleTag = document.createElement('style')\n        this.styleTag.id = 'unistyles-web'\n        document.head.appendChild(this.styleTag)\n    }\n\n    set = ({ className, propertyKey, value, mediaQuery = '', isMq }: SetProps) => {\n        const firstLevelMap = isMq ? this.mqMap : this.mainMap\n        const secondLevelMap = safeGetMap(firstLevelMap, mediaQuery)\n        const thirdLevelMap = safeGetMap(secondLevelMap, className)\n        if (thirdLevelMap.has(propertyKey) && thirdLevelMap.get(propertyKey) === value) {\n            return\n        }\n\n        thirdLevelMap.set(propertyKey, value)\n        if (this.styleTag) {\n            const dirty = this.dirtyRules.get(secondLevelMap) ?? new Set<string>()\n            dirty.add(className)\n            this.dirtyRules.set(secondLevelMap, dirty)\n        }\n    }\n\n    add = (hash: string, values: UnistylesValues) => {\n        convertToCSS(hash, convertUnistyles(values, this.services.runtime), this)\n        this.recreate()\n    }\n\n    recreate = () => {\n        if (!this.styleTag) {\n            return\n        }\n\n        const sheet = this.styleTag.sheet!\n        // Adopt SSR text once. Subsequent updates must retain unrelated CSS rules.\n        if (this.needsHydration) {\n            while (sheet.cssRules.length) {\n                sheet.deleteRule(0)\n            }\n            this.needsHydration = false\n        }\n\n        if (this.themesDirty) {\n            while (this.themeRuleCount) {\n                sheet.deleteRule(0)\n                this.themeRuleCount--\n            }\n            for (const css of this.themesCSS.values()) {\n                sheet.insertRule(css, this.themeRuleCount++)\n            }\n            this.themesDirty = false\n        }\n\n        let groupIndex = this.themeRuleCount\n        for (const map of [this.mainMap, this.mqMap]) {\n            for (const [mediaQuery, styles] of map) {\n                let group = this.ruleGroups.get(styles)\n                const dirty = this.dirtyRules.get(styles)\n                if (dirty) {\n                    if (!group) {\n                        const parent = mediaQuery\n                            ? sheet.cssRules[sheet.insertRule(`${mediaQuery}{}`, groupIndex)] as CSSGroupingRule\n                            : sheet\n                        group = { sheet: parent, rules: new Map() }\n                        this.ruleGroups.set(styles, group)\n                    }\n\n                    for (const className of dirty) {\n                        const values = styles.get(className)\n                        const rule = group.rules.get(className)\n                        if (!values) {\n                            if (rule) {\n                                for (let i = 0; i < group.sheet.cssRules.length; i++) {\n                                    if (group.sheet.cssRules[i] === rule) {\n                                        group.sheet.deleteRule(i)\n                                        break\n                                    }\n                                }\n                                group.rules.delete(className)\n                            }\n                            continue\n                        }\n\n                        let declarations = ''\n                        for (const [key, value] of values) {\n                            if (value !== undefined) {\n                                declarations += `${hyphenate(key)}:${value};`\n                            }\n                        }\n                        if (rule) {\n                            rule.style.cssText = declarations\n                        } else {\n                            const index = group.sheet.insertRule(\n                                `.${className}{${declarations}}`,\n                                mediaQuery ? group.sheet.cssRules.length : groupIndex + group.rules.size,\n                            )\n                            group.rules.set(className, group.sheet.cssRules[index] as CSSStyleRule)\n                        }\n                    }\n                }\n                if (group) {\n                    groupIndex += mediaQuery ? 1 : group.rules.size\n                }\n            }\n        }\n        this.dirtyRules.clear()\n    }\n\n    addTheme = (theme: string, values: Record<string, any>) => {\n        let themeVars = ''\n\n        const convertToCSS = (key: string, value: any, prev = '-') => {\n            if (typeof value === 'object' && value !== null) {\n                Object.entries(value).forEach(([nestedKey, nestedValue]) =>\n                    convertToCSS(nestedKey, nestedValue, `${prev}-${key}`),\n                )\n            }\n\n            if (typeof value === 'string') {\n                themeVars += `${prev}-${hyphenate(key)}:${value};`\n            }\n        }\n\n        Object.entries(values).forEach(([key, value]) => convertToCSS(key, value))\n\n        if (theme === 'light' || theme === 'dark') {\n            const key = `media ${theme}`\n            const css = `@media (prefers-color-scheme: ${theme}){:root{${themeVars}}}`\n            if (this.themesCSS.get(key) !== css) {\n      